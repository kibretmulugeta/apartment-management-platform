# --- Database Configuration ---
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/property_management

# --- Redis & Celery Workers ---
REDIS_URL=redis://localhost:6379/0

# --- JWT & Security ---
JWT_SECRET=super_secret_jwt_key_change_me_in_production_9f88c7
JWT_REFRESH_SECRET=super_secret_refresh_key_change_me_9f88c7
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Notification Providers (Brevo Free Tier / Twilio) ---
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_free_tier_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here

# --- OAuth Providers (Google, Microsoft, Facebook, LinkedIn) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
